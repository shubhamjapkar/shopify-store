{% stylesheet %}
  .av {
    --av-green: #00a308;
    --av-green-dark: #008a07;
    --av-fg: #252525;
    --av-muted: #6b6b6b;
    --av-bg: #ffffff;
    --av-soft: #f6f7f7;
    --av-border: #e4e7e4;
    --av-star: #f5b301;
    --av-black: #111111;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--av-fg);
    background: var(--av-bg);
    font-size: 16px;
    line-height: 1.6;
  }
  .av *, .av *::before, .av *::after { box-sizing: border-box; }
  .av img { max-width: 100%; }
  .av a { color: inherit; text-decoration: none; }

  /* Stars */
  .av-stars { position: relative; display: inline-block; font-size: 1.15rem; letter-spacing: 2px; color: #dcdcdc; line-height: 1; white-space: nowrap; }
  .av-stars::before { content: "★★★★★"; position: absolute; left: 0; top: 0; width: var(--pct, 92%); overflow: hidden; color: var(--av-star); white-space: nowrap; }

  /* Announcement */
  .av-ann { display: flex; align-items: center; justify-content: center; gap: 1rem; background: #000; color: #fff; padding: .7rem 1rem; font-size: .95rem; }
  .av-ann__arrow { background: none; border: none; color: #fff; cursor: pointer; padding: 0 .25rem; display: inline-flex; }
  .av-ann__viewport { position: relative; min-height: 1.4em; display: flex; align-items: center; justify-content: center; min-width: min(80vw, 360px); text-align: center; }
  .av-ann__slide { position: absolute; opacity: 0; transition: opacity .4s ease; font-weight: 500; pointer-events: none; white-space: nowrap; }
  .av-ann__slide.is-active { position: relative; opacity: 1; pointer-events: auto; }

  /* Header */
  .av-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid #f0f0f0; }
  .av-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; max-width: 1280px; margin: 0 auto; padding: 1rem 1.5rem; }
  .av-nav { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; font-size: 1rem; max-width: 34rem; }
  .av-nav a { color: #1a1a1a; }
  .av-nav a:hover { color: var(--av-green); }
  .av-logo { justify-self: center; display: inline-flex; align-items: flex-start; font-weight: 700; }
  .av-logo__text { font-size: 1.35rem; font-weight: 700; color: #1f5c33; letter-spacing: .2px; }
  .av-logo__text--sm { font-size: 1.05rem; }
  .av-logo__accent { color: var(--av-green); }
  .av-logo__tm { font-size: .65rem; margin-top: .15rem; color: #1f5c33; }
  .av-header__actions { justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .av-locale { display: inline-flex; align-items: center; gap: .3rem; background: none; border: none; cursor: pointer; font: inherit; color: #1a1a1a; }
  .av-iconbtn { position: relative; background: none; border: none; cursor: pointer; color: #1a1a1a; display: inline-flex; padding: 0; }
  .av-cart-count { position: absolute; top: -6px; right: -8px; background: var(--av-green); color: #fff; font-size: .68rem; font-weight: 700; min-width: 17px; height: 17px; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0 3px; }

  /* Product */
  .av-product { background: #fff; }
  .av-product__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; max-width: 1280px; margin: 0 auto; padding: 1.5rem 1.5rem 2.5rem; align-items: start; }
  .av-gallery { display: flex; flex-direction: column; gap: .9rem; }
  .av-gallery__img { width: 100%; height: auto; display: block; border-radius: 12px; background: var(--av-soft); }

  .av-buybox { position: sticky; top: 90px; }
  .av-rating { display: flex; align-items: center; gap: .6rem; margin-bottom: .9rem; }
  .av-rating__text { font-weight: 600; }
  .av-rating__count { color: var(--av-muted); font-weight: 500; }
  .av-title { font-size: clamp(1.7rem, 3vw, 2.35rem); font-weight: 700; line-height: 1.2; margin: 0 0 1.1rem; color: rgba(0,0,0,.82); }

  .av-price { display: flex; align-items: center; flex-wrap: wrap; gap: .7rem; margin-bottom: 1.1rem; }
  .av-price__now { font-size: 1.75rem; font-weight: 700; }
  .av-price__was { font-size: 1.35rem; color: var(--av-muted); text-decoration: line-through; }
  .av-price__badge { background: var(--av-green); color: #fff; font-weight: 700; font-size: .82rem; padding: .4rem .7rem; border-radius: 8px; letter-spacing: .3px; }

  .av-pill { display: inline-flex; align-items: center; gap: .5rem; border: 1px solid var(--av-border); border-radius: 8px; padding: .65rem 1rem; font-size: .82rem; font-weight: 700; letter-spacing: .3px; margin-bottom: 1.4rem; text-transform: uppercase; }
  .av-pill__ico { color: var(--av-green); }

  .av-checks { list-style: none; padding: 0; margin: 0 0 1.75rem; }
  .av-checks li { position: relative; padding-left: 2rem; margin-bottom: .85rem; font-size: 1.05rem; font-weight: 600; }
  .av-checks li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--av-green); font-weight: 800; font-size: 1.2rem; }

  .av-offer-title { display: flex; align-items: center; text-align: center; gap: 1rem; margin: 0 0 1rem; font-weight: 600; }
  .av-offer-title::before, .av-offer-title::after { content: ""; flex: 1; height: 1px; background: var(--av-border); }
  .av-offers { display: flex; flex-direction: column; gap: .9rem; margin-bottom: 1.4rem; }
  .av-offer { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; border: 2px solid var(--av-border); border-radius: 12px; padding: 1.1rem 1.1rem; cursor: pointer; transition: border-color .15s ease, background .15s ease; }
  .av-offer.is-selected { border-color: #111; }
  .av-offer input { position: absolute; opacity: 0; pointer-events: none; }
  .av-offer__flag { position: absolute; top: -.8rem; right: 1rem; background: #000; color: #fff; font-size: .72rem; font-weight: 600; padding: .28rem .65rem; border-radius: 6px; }
  .av-offer__flag--best { background: var(--av-green); }
  .av-offer__thumb { width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: var(--av-soft); flex: none; }
  .av-offer__thumb img { width: 100%; height: 100%; object-fit: contain; }
  .av-offer__name { font-weight: 700; font-size: 1.15rem; }
  .av-offer__tag { display: inline-block; background: #ececec; color: var(--av-fg); font-size: .72rem; font-weight: 600; padding: .2rem .5rem; border-radius: 5px; margin-left: .3rem; vertical-align: middle; }
  .av-offer__sub { display: block; font-size: .9rem; color: var(--av-muted); margin-top: .15rem; }
  .av-offer__price { text-align: right; white-space: nowrap; }
  .av-offer__now { display: block; font-weight: 700; font-size: 1.35rem; }
  .av-offer__was { display: block; font-size: .9rem; color: var(--av-muted); text-decoration: line-through; }

  .av-satisfied { text-align: center; font-weight: 600; margin: 0 0 1rem; }

  /* CTA */
  .av-form { margin: 0; }
  .av-cta { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .5rem; width: 100%; background: var(--av-green); color: #fff; font-size: 1.2rem; font-weight: 600; padding: 1.05rem 1.25rem; border: none; border-radius: 10px; cursor: pointer; min-height: 60px; transition: background .15s ease, transform .05s ease; font-family: inherit; }
  .av-cta:hover { background: var(--av-green-dark); }
  .av-cta:active { transform: translateY(1px); }
  .av-cta:focus-visible { outline: 4px solid #f5b301; outline-offset: 3px; }
  .av-cta[disabled], .av-cta.is-loading { background: #9aa5a2; cursor: not-allowed; }
  .av-cta__sep { opacity: .55; }
  .av-cta__was { text-decoration: line-through; opacity: .8; font-weight: 500; }

  .av-cart-msg { margin: .75rem 0 0; text-align: center; font-weight: 600; font-size: .95rem; }
  .av-cart-msg[hidden] { display: none; }
  .av-cart-msg.is-success { color: var(--av-green-dark); }
  .av-cart-msg.is-error { color: #c0392b; }

  .av-line { display: flex; align-items: center; justify-content: center; gap: .5rem; text-align: center; font-size: 1rem; margin: 1rem 0 0; }
  .av-line__ico { font-size: 1.1rem; }

  /* Payment badges */
  .av-pay { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem; margin-top: 1rem; }
  .av-pay__card { height: 26px; min-width: 40px; padding: 0 6px; border-radius: 4px; background: #fff; border: 1px solid #e2e2e2; font-size: .62rem; font-weight: 800; letter-spacing: .3px; display: inline-flex; align-items: center; justify-content: center; color: #1a1a6b; }
  .av-pay__visa { color: #1a1f71; }
  .av-pay__mc { gap: 0; }
  .av-pay__mc i { width: 15px; height: 15px; border-radius: 50%; display: inline-block; }
  .av-pay__mc i:first-child { background: #eb001b; }
  .av-pay__mc i:last-child { background: #f79e1b; margin-left: -6px; mix-blend-mode: multiply; }
  .av-pay__apple { color: #000; }
  .av-pay__apple::before { content: ""; display: inline-block; }
  .av-pay__gpay { color: #5f6368; }
  .av-pay__pp { color: #003087; }
  .av-pay__amex { color: #fff; background: #2e77bc; border-color: #2e77bc; }
  .av-pay__banc { color: #005498; font-size: .55rem; }

  /* Featured testimonial */
  .av-hero-quote { border: 1px solid var(--av-border); border-radius: 14px; padding: 1.5rem; margin: 1.75rem 0 0; }
  .av-hero-quote blockquote { margin: .6rem 0 1rem; font-size: 1.02rem; }
  .av-hero-quote figcaption { display: flex; flex-direction: column; }
  .av-hero-quote__name { font-weight: 700; }
  .av-hero-quote__meta { color: var(--av-muted); font-size: .85rem; }

  /* Accordions */
  .av-acc-group { margin-top: 1.25rem; }
  .av-acc { border-bottom: 1px solid var(--av-border); }
  .av-acc summary { cursor: pointer; list-style: none; padding: 1.15rem 2rem 1.15rem 0; position: relative; font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: .6rem; }
  .av-acc summary::-webkit-details-marker { display: none; }
  .av-acc summary::after { content: "+"; position: absolute; right: .1rem; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: #444; font-weight: 400; }
  .av-acc[open] summary::after { content: "–"; }
  .av-acc__ico { color: #444; font-size: 1rem; }
  .av-acc__body { padding: 0 0 1.15rem; color: #444; }
  .av-acc__body p { margin: 0 0 .8rem; }
  .av-acc__body p:last-child { margin-bottom: 0; }

  /* Press marquee */
  .av-press { padding: 2rem 0; background: var(--av-soft); }
  .av-marquee { overflow: hidden; width: 100%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .av-marquee__track { display: inline-flex; align-items: center; gap: 4rem; white-space: nowrap; animation: av-scroll 32s linear infinite; }
  .av-press__logo img { height: 30px; width: auto; opacity: .85; }
  @keyframes av-scroll { from { transform: translateX(0); } to { transform: translateX(-33.333%); } }
  @media (prefers-reduced-motion: reduce) { .av-marquee__track { animation: none; } }

  /* Reviews */
  .av-reviews { padding: 3rem 1.5rem; max-width: 1200px; margin: 0 auto; }
  .av-reviews__head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; }
  .av-reviews__title { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 700; margin: 0; }
  .av-reviews__summary { display: flex; align-items: center; gap: .5rem; margin-top: .4rem; }
  .av-reviews__score { font-weight: 700; }
  .av-reviews__count { color: var(--av-muted); }
  .av-review-write-btn { display: inline-flex; align-items: center; gap: .5rem; background: #fff; color: var(--av-green-dark); border: 2px solid var(--av-green); border-radius: 10px; padding: .7rem 1.25rem; font: inherit; font-weight: 600; cursor: pointer; transition: background .15s ease, color .15s ease; }
  .av-review-write-btn:hover { background: var(--av-green); color: #fff; }

  .av-review-form { background: var(--av-soft); border: 1px solid var(--av-border); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.75rem; max-width: 640px; }
  .av-review-form[hidden] { display: none; }
  .av-review-form__title { font-size: 1.2rem; font-weight: 700; margin: 0 0 1rem; }
  .av-review-form__label { display: block; font-weight: 600; margin-bottom: .4rem; }
  .av-rate { display: inline-flex; gap: .2rem; margin-bottom: 1rem; }
  .av-rate__star { background: none; border: none; padding: 0 .1rem; font-size: 1.9rem; line-height: 1; cursor: pointer; color: #dcdcdc; transition: color .1s ease; }
  .av-rate__star.is-on { color: var(--av-star); }
  .av-rate__star:focus-visible { outline: 2px solid var(--av-green); outline-offset: 2px; border-radius: 4px; }
  .av-review-form__row { margin-bottom: .9rem; }
  .av-review-form__input, .av-review-form__textarea { width: 100%; border: 1px solid var(--av-border); border-radius: 10px; padding: .8rem 1rem; font: inherit; background: #fff; color: var(--av-fg); }
  .av-review-form__input:focus, .av-review-form__textarea:focus { outline: none; border-color: var(--av-green); }
  .av-review-form__textarea { resize: vertical; min-height: 96px; }
  .av-review-form__submit { background: var(--av-green); color: #fff; border: none; border-radius: 10px; padding: .85rem 1.5rem; font: inherit; font-weight: 600; cursor: pointer; transition: background .15s ease; }
  .av-review-form__submit:hover { background: var(--av-green-dark); }
  .av-review-form__msg { margin: .85rem 0 0; font-weight: 600; font-size: .95rem; }
  .av-review-form__msg[hidden] { display: none; }
  .av-review-form__msg.is-success { color: var(--av-green-dark); }
  .av-review-form__msg.is-error { color: #c0392b; }

  .av-reviews__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .av-review { background: #fff; border: 1px solid var(--av-border); border-radius: 14px; padding: 1.6rem; margin: 0; }
  .av-review--extra.is-collapsed { display: none; }
  .av-review--user { border-color: var(--av-green); box-shadow: 0 0 0 1px var(--av-green) inset; }
  .av-review__name { font-weight: 700; margin: .7rem 0 .3rem; display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .av-review__badge { color: var(--av-green); font-size: .72rem; font-weight: 600; }
  .av-review blockquote { margin: 0 0 1rem; font-size: 1rem; color: #333; }
  .av-review__date { display: block; color: var(--av-muted); font-size: .9rem; font-style: italic; }
  .av-reviews__more { text-align: center; margin-top: 2rem; }
  .av-reviews__more-btn { background: #fff; color: var(--av-fg); border: 2px solid var(--av-border); border-radius: 10px; padding: .85rem 1.75rem; font: inherit; font-weight: 600; cursor: pointer; transition: border-color .15s ease, color .15s ease; }
  .av-reviews__more-btn:hover { border-color: var(--av-green); color: var(--av-green-dark); }
  .av-reviews__more-btn[hidden] { display: none; }

  /* Feature story */
  .av-story { max-width: 1180px; margin: 0 auto; padding: 1rem 1.5rem 2rem; }
  .av-story__h3 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; margin: 1.5rem 0 1rem; line-height: 1.35; }
  .av-story__h5 { font-size: 1.2rem; font-weight: 500; margin: 1.25rem 0; line-height: 1.6; }
  .av-story__p { font-size: 1.15rem; margin: 1.1rem 0; line-height: 1.7; }
  .av-story__p strong { font-weight: 700; }
  .av-story__img { text-align: center; margin: 1.25rem 0; }
  .av-story__img img { display: inline-block; border-radius: 8px; }

  /* Stats */
  .av-stats { padding: 2rem 1.5rem 3rem; background: var(--av-soft); }
  .av-stats__title { text-align: center; font-size: 1.2rem; margin: 0 0 2rem; }
  .av-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; max-width: 900px; margin: 0 auto; }
  .av-stat { text-align: center; }
  .av-stat__num { display: block; font-size: 3.2rem; font-weight: 800; line-height: 1; margin-bottom: .6rem; }
  .av-stat__label { font-size: 1rem; color: #333; }

  /* Comparison */
  .av-compare { padding: 3rem 1.5rem; }
  .av-compare__h2 { text-align: center; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 700; margin: 0 0 1.5rem; }
  .av-compare__sub { text-align: center; font-size: 1.15rem; margin: 0 0 1.5rem; }
  .av-table-wrap { overflow-x: auto; max-width: 820px; margin: 0 auto; }
  .av-table { width: 100%; border-collapse: collapse; font-size: 1.05rem; min-width: 480px; }
  .av-table th, .av-table td { padding: 1rem; border-bottom: 1px solid var(--av-border); text-align: center; vertical-align: middle; }
  .av-table thead th { font-weight: 700; padding-bottom: 1.25rem; }
  .av-table tbody th { text-align: left; font-weight: 600; }
  .av-table .av-col-us { background: #f4f4f4; }
  .av-table tbody tr:last-child th, .av-table tbody tr:last-child td { border-bottom: none; }
  .av-yes::before { content: "✓"; color: #111; font-size: 1.3rem; font-weight: 700; }
  .av-no::before { content: "✕"; color: #111; font-size: 1.2rem; }

  /* Video */
  .av-video { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; text-align: center; }
  .av-video__title { font-size: clamp(1.5rem, 2.8vw, 2rem); font-weight: 700; margin: 0 0 1.5rem; }
  .av-video__frame { position: relative; border-radius: 14px; overflow: hidden; background: #000; }
  .av-video__el { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .av-video__play { position: absolute; inset: 0; margin: auto; width: 74px; height: 74px; border-radius: 50%; border: 2px solid rgba(255,255,255,.9); background: rgba(0,0,0,.25); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; padding-left: 4px; }
  .av-video__frame.is-playing .av-video__play { display: none; }

  /* Help / FAQ */
  .av-help { max-width: 820px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
  .av-help__title { text-align: center; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; margin: 0 0 1rem; }
  .av-help__lead { text-align: center; color: #333; margin: 0 auto 2rem; max-width: 620px; }
  .av-help__faqtitle { font-size: 1.4rem; font-weight: 700; margin: 0 0 .5rem; }
  .av-faq .av-acc summary { font-weight: 600; }

  /* Footer utilities */
  .av-futil { background: #000; padding: 3.5rem 1.5rem 0; }
  .av-futil__card { background: #000; border: 1px solid #2a2a2a; border-radius: 18px; max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; padding: 2.5rem 2rem; }
  .av-futil__item { text-align: center; color: #fff; }
  .av-futil__ico { font-size: 1.8rem; display: block; margin-bottom: .75rem; }
  .av-futil__item h3 { font-size: 1.15rem; font-weight: 700; margin: 0 0 .6rem; }
  .av-futil__item p { font-size: .92rem; color: #cfcfcf; margin: 0; }

  /* Footer */
  .av-footer { background: #000; color: #fff; padding: 3.5rem 1.5rem 1.5rem; }
  .av-footer__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .av-footer__col h4 { font-size: 1.3rem; font-weight: 700; margin: 0 0 1.25rem; }
  .av-footer__col ul { list-style: none; padding: 0; margin: 0; }
  .av-footer__col li { margin-bottom: .9rem; }
  .av-footer__col a { color: #eaeaea; }
  .av-footer__col a:hover { color: #fff; text-decoration: underline; }
  .av-footer__news p { color: #cfcfcf; margin: 0 0 1.25rem; }
  .av-news { display: flex; align-items: center; gap: .5rem; max-width: 320px; border: 1px solid #fff; border-radius: 10px; padding: .3rem .3rem .3rem 1rem; }
  .av-news input { flex: 1; background: none; border: none; color: #fff; font: inherit; padding: .7rem 0; outline: none; }
  .av-news input::placeholder { color: #cfcfcf; }
  .av-news button { background: none; border: none; color: #fff; cursor: pointer; display: inline-flex; padding: .5rem; }
  .av-footer__bottom { max-width: 1200px; margin: 3rem auto 0; padding-top: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .av-copy { margin: 0; color: #cfcfcf; }

  /* Sticky bar */
  .av-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: transparent; padding: .6rem 1rem; }
  .av-sticky[hidden] { display: none; }
  .av-sticky__form { max-width: 1100px; margin: 0 auto; }
  .av-cta--sticky { min-height: 52px; font-size: 1.1rem; box-shadow: 0 8px 24px rgba(0,0,0,.18); }

  /* Responsive */
  @media (max-width: 900px) {
    .av-futil__card { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .av-header__inner { grid-template-columns: auto 1fr auto; gap: .5rem; padding: .75rem 1rem; }
    .av-nav { display: none; }
    .av-product__inner { grid-template-columns: 1fr; gap: 1.5rem; padding: 1rem 1rem 2rem; }
    .av-buybox { position: static; top: auto; }
    .av-title { font-size: 1.6rem; }
    .av-reviews__grid { grid-template-columns: 1fr; }
    .av-stats__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .av-futil__card { grid-template-columns: 1fr; }
    .av-footer__inner { grid-template-columns: 1fr; gap: 2rem; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('[data-av-root]').forEach(function (root) {
      /* Rotating announcement */
      (function () {
        var wrap = root.querySelector('[data-av-ann]');
        if (!wrap) return;
        var slides = Array.prototype.slice.call(wrap.querySelectorAll('[data-av-ann-slide]'));
        if (slides.length < 2) return;
        var idx = 0, timer;
        function show(i) { idx = (i + slides.length) % slides.length; slides.forEach(function (s, n) { s.classList.toggle('is-active', n === idx); }); }
        function next() { show(idx + 1); }
        function prev() { show(idx - 1); }
        function start() { stop(); timer = setInterval(next, 4000); }
        function stop() { if (timer) clearInterval(timer); }
        var n = wrap.querySelector('[data-av-ann-next]'), p = wrap.querySelector('[data-av-ann-prev]');
        if (n) n.addEventListener('click', function () { next(); start(); });
        if (p) p.addEventListener('click', function () { prev(); start(); });
        start();
      })();

      /* Delivery estimate (today +5 to +9 days) */
      (function () {
        var from = root.querySelector('[data-av-ship-from]'), to = root.querySelector('[data-av-ship-to]');
        if (!from || !to) return;
        var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
        function fmt(d) { return months[d.getMonth()] + ' ' + d.getDate(); }
        var a = new Date(); a.setDate(a.getDate() + 5);
        var b = new Date(); b.setDate(b.getDate() + 9);
        from.textContent = fmt(a); to.textContent = fmt(b);
      })();

      /* Offer selector */
      (function () {
        var group = root.querySelector('[data-av-offers]');
        if (!group) return;
        var offers = group.querySelectorAll('.av-offer');
        offers.forEach(function (offer) {
          offer.addEventListener('click', function () {
            offers.forEach(function (o) { o.classList.remove('is-selected'); });
            offer.classList.add('is-selected');
            var radio = offer.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
            var price = offer.getAttribute('data-price'), was = offer.getAttribute('data-was'), qty = offer.getAttribute('data-qty');
            root.querySelectorAll('[data-av-cta-price]').forEach(function (el) { if (price) el.textContent = price; });
            root.querySelectorAll('[data-av-cta-was]').forEach(function (el) { if (was) el.textContent = was; });
            root.querySelectorAll('[data-av-qty]').forEach(function (q) { if (qty) q.value = qty; });
          });
        });
      })();

      /* Video play */
      (function () {
        var frame = root.querySelector('[data-av-video]');
        if (!frame) return;
        var vid = frame.querySelector('video'), btn = frame.querySelector('[data-av-video-play]');
        if (!vid || !btn) return;
        btn.addEventListener('click', function () { frame.classList.add('is-playing'); vid.play(); });
        vid.addEventListener('pause', function () { if (vid.currentTime === 0) frame.classList.remove('is-playing'); });
      })();

      /* Add to cart (AJAX with fallback) */
      (function () {
        var addUrl = root.getAttribute('data-cart-add-url') || '/cart/add';
        var cartUrl = root.getAttribute('data-cart-url') || '/cart';
        root.querySelectorAll('[data-av-cart-form]').forEach(function (form) {
          form.addEventListener('submit', function (e) {
            var variant = form.querySelector('[data-av-variant]');
            if (!variant || !variant.value) {
              e.preventDefault();
              showMsg(form, 'Select a product in the theme editor to enable add to cart.', 'error');
              return;
            }
            e.preventDefault();
            var btn = form.querySelector('[data-av-cta]');
            if (btn) { btn.classList.add('is-loading'); btn.setAttribute('aria-busy', 'true'); }
            fetch(addUrl + '.js', { method: 'POST', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
              .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
              .then(function (r) {
                if (btn) { btn.classList.remove('is-loading'); btn.removeAttribute('aria-busy'); }
                if (!r.ok) { showMsg(form, (r.data && r.data.description) || 'Could not add to cart.', 'error'); return; }
                showMsg(form, 'Added to cart ✓ Redirecting…', 'success');
                document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
                window.setTimeout(function () { window.location.href = cartUrl; }, 600);
              })
              .catch(function () { if (btn) { btn.classList.remove('is-loading'); btn.removeAttribute('aria-busy'); } form.submit(); });
          });
        });
        function showMsg(form, text, kind) {
          var el = form.querySelector('[data-av-cart-msg]');
          if (!el) { window.alert(text); return; }
          el.textContent = text; el.classList.remove('is-success', 'is-error');
          el.classList.add(kind === 'success' ? 'is-success' : 'is-error'); el.hidden = false;
        }
      })();

      /* Reviews: write a review + show more */
      (function () {
        var section = root.querySelector('[data-av-reviews]');
        if (!section) return;
        var grid = section.querySelector('[data-av-reviews-grid]');
        var toggle = section.querySelector('[data-av-write-toggle]');
        var form = section.querySelector('[data-av-review-form]');
        var moreBtn = section.querySelector('[data-av-more]');
        var countEls = section.querySelectorAll('[data-av-review-count]');
        var msgEl = section.querySelector('[data-av-review-msg]');
        var key = 'av_reviews_' + (section.getAttribute('data-av-reviews') || 'default');
        var BATCH = 3;

        /* Toggle the write-a-review form */
        if (toggle && form) {
          toggle.addEventListener('click', function () {
            var isHidden = form.hasAttribute('hidden');
            if (isHidden) {
              form.removeAttribute('hidden');
              toggle.setAttribute('aria-expanded', 'true');
              var first = form.querySelector('input, textarea');
              if (first) first.focus();
            } else {
              form.setAttribute('hidden', '');
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
        }

        /* Star rating input */
        var rating = 0;
        var rateWrap = section.querySelector('[data-av-rate]');
        var stars = rateWrap ? Array.prototype.slice.call(rateWrap.querySelectorAll('.av-rate__star')) : [];
        function paint(n) { stars.forEach(function (s, i) { s.classList.toggle('is-on', i < n); }); }
        if (rateWrap) {
          stars.forEach(function (s) {
            var v = parseInt(s.getAttribute('data-val'), 10);
            s.addEventListener('mouseenter', function () { paint(v); });
            s.addEventListener('click', function () { rating = v; paint(v); });
          });
          rateWrap.addEventListener('mouseleave', function () { paint(rating); });
        }

        function esc(str) { var d = document.createElement('div'); d.textContent = str == null ? '' : str; return d.innerHTML; }
        function todayFr() {
          var d = new Date();
          function p(n) { return (n < 10 ? '0' : '') + n; }
          var mo = ['January','February','March','April','May','June','July','August','September','October','November','December'];
          return mo[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
        }
        function makeCard(r) {
          var pct = Math.max(0, Math.min(100, Math.round((r.rating / 5) * 100)));
          var fig = document.createElement('figure');
          fig.className = 'av-review av-review--user';
          fig.innerHTML =
            '<div class="av-stars" aria-hidden="true" style="--pct:' + pct + '%;">★★★★★</div>' +
            '<figcaption class="av-review__name">' + esc(r.name) + ' <span class="av-review__badge">✔ Posted by you</span></figcaption>' +
            '<blockquote>« ' + esc(r.content) + ' »</blockquote>' +
            '<time class="av-review__date">' + esc(r.date) + '</time>';
          return fig;
        }
        function showMsg(text, kind) {
          if (!msgEl) return;
          msgEl.textContent = text;
          msgEl.classList.remove('is-success', 'is-error');
          msgEl.classList.add(kind === 'success' ? 'is-success' : 'is-error');
          msgEl.hidden = false;
        }

        /* Restore previously submitted reviews */
        var saved = [];
        try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { saved = []; }
        if (grid && saved.length) {
          saved.forEach(function (r) { grid.insertBefore(makeCard(r), grid.firstChild); });
          countEls.forEach(function (el) {
            var n = parseInt((el.textContent || '').replace(/\D/g, ''), 10) || 0;
            el.textContent = n + saved.length;
          });
        }

        /* Submit a new review */
        if (form && grid) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var name = (form.querySelector('[name="name"]').value || '').trim();
            var content = (form.querySelector('[name="content"]').value || '').trim();
            if (!rating) { showMsg('Please select a rating.', 'error'); return; }
            if (!name || !content) { showMsg('Please enter your name and review.', 'error'); return; }
            var review = { name: name, content: content, rating: rating, date: todayFr() };
            grid.insertBefore(makeCard(review), grid.firstChild);
            saved.unshift(review);
            try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
            countEls.forEach(function (el) {
              var n = parseInt((el.textContent || '').replace(/\D/g, ''), 10) || 0;
              el.textContent = n + 1;
            });
            form.reset();
            rating = 0;
            paint(0);
            showMsg('Thank you! Your review has been published.', 'success');
          });
        }

        /* See more reviews */
        if (moreBtn && grid) {
          moreBtn.addEventListener('click', function () {
            var extras = Array.prototype.slice.call(grid.querySelectorAll('.av-review--extra.is-collapsed'));
            extras.slice(0, BATCH).forEach(function (el) { el.classList.remove('is-collapsed'); });
            if (grid.querySelectorAll('.av-review--extra.is-collapsed').length === 0) {
              moreBtn.hidden = true;
            }
          });
          if (grid.querySelectorAll('.av-review--extra.is-collapsed').length === 0) {
            moreBtn.hidden = true;
          }
        }
      })();

      /* Sticky bar */
      (function () {
        var bar = root.querySelector('[data-av-sticky]');
        var anchor = root.querySelector('.av-buybox .av-cta');
        if (!bar || !anchor || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { bar.hidden = en.isIntersecting || en.boundingClientRect.top > 0; });
        }, { rootMargin: '0px 0px -100% 0px' });
        io.observe(anchor);
      })();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Astuvita — Product Page",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product (enables add to cart)" },
