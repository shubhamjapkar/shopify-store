.jpg?v=1784993690" },
    { "type": "header", "content": "Press bar (URLs, comma-separated)" },
    { "type": "textarea", "id": "press_logos", "label": "Logos", "default": "https://cdn.shopify.com/s/files/1/0786/9854/5290/files/logo_seniors_magazine.png?v=1784993677, https://cdn.shopify.com/s/files/1/0786/9854/5290/files/Medisite.png?v=1784993682, https://cdn.shopify.com/s/files/1/0786/9854/5290/files/Marie-Claire-Logo.png?v=1784993677, https://cdn.shopify.com/s/files/1/0786/9854/5290/files/Logo_Le_Figaro_svg.png?v=1784993681" }
  ],
  "presets": [
