      <video autoplay muted loop playsinline webkit-playsinline preload="auto" data-av-autoplay>
        <source src="https://cdn.shopify.com/videos/c/o/v/31452296f28e4cf1bb3910323999c5eb.mp4" type="video/mp4">
      </video>
    </div>
    <script>
      (function () {
        var v = document.querySelector('[data-av-autoplay]');
        if (!v) return;
        v.muted = true;
        v.setAttribute('muted', '');
        function go() { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        if (document.readyState === 'complete') { go(); } else { window.addEventListener('load', go); }
        document.addEventListener('touchstart', function once() {
          if (v.paused) go();
          document.removeEventListener('touchstart', once);
        }, { passive: true });
      })();
