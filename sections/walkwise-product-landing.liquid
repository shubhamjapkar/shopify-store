      <a class="av-logo" href="{{ routes.root_url }}">
        <img class="av-logo__img" src="https://cdn.shopify.com/s/files/1/0786/9854/5290/files/walk_wise_logo_2.png?v=1784951696" alt="WalkWise" width="120" height="120" loading="eager">
      </a>
      <div class="av-header__actions">
        <a href="{{ routes.cart_url }}" class="av-iconbtn av-cart-link" aria-label="Cart">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 7a3 3 0 016 0" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          <span class="av-cart-count" data-av-cart-count>{{ cart.item_count | default: 0 }}</span>
        </a>
      </div>
    </div>
  </header>

  {%- comment -%} ========== Product ========== {%- endcomment -%}
