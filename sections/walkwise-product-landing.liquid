        <h4>Subscribe to our newsletter</h4>
        <p>Be the first to hear about our offers and news.</p>
        {%- form 'customer', class: 'av-news-form', return_to: request.path -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="av-news__msg av-news__msg--ok" role="status">✓ Thanks for subscribing! Check your inbox to confirm.</p>
          {%- elsif form.errors -%}
            <p class="av-news__msg av-news__msg--err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          {%- unless form.posted_successfully? -%}
            <div class="av-news">
              <input type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" aria-label="Email address" autocomplete="email" required>
              <button type="submit" aria-label="Subscribe">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          {%- endunless -%}
        {%- endform -%}
        <script>
          (function () {
            var form = document.querySelector('.av-footer__news form');
            if (!form || form.dataset.avBound) return;
            form.dataset.avBound = '1';
            /* Fallback: even if preventDefault ever fails, post into a hidden iframe instead of navigating */
            var sink = document.createElement('iframe');
            sink.name = 'av-news-sink';
            sink.style.display = 'none';
            sink.setAttribute('aria-hidden', 'true');
            document.body.appendChild(sink);
            form.setAttribute('target', 'av-news-sink');
            function toast(text, isError) {
              var t = document.createElement('div');
              t.className = 'av-toast' + (isError ? ' av-toast--err' : '');
              t.setAttribute('role', 'status');
              t.innerHTML = '<span>' + text + '</span><button type="button" class="av-toast__close" aria-label="Close">&#10005;</button>';
              document.body.appendChild(t);
              requestAnimationFrame(function () { t.classList.add('is-visible'); });
              function remove() {
                t.classList.remove('is-visible');
                setTimeout(function () { if (t.parentNode) t.parentNode.removeChild(t); }, 250);
              }
              t.querySelector('.av-toast__close').addEventListener('click', remove);
              setTimeout(remove, 3000);
            }
            form.addEventListener('submit', function (e) {
              e.preventDefault();
              e.stopPropagation();
              var input = form.querySelector('input[type="email"]');
              var email = input ? input.value.trim() : '';
              if (!email) { toast('Please enter your email address.', true); return false; }
              fetch(form.getAttribute('action'), { method: 'POST', body: new FormData(form) })
                .then(function () {
                  toast('✓ Thanks for subscribing!');
                  if (input) input.value = '';
                })
                .catch(function () {
                  toast('Something went wrong. Please try again.', true);
                });
              return false;
            });
          })();
        </script>
      </div>
    </div>
    <div class="av-footer__bottom">
      <div class="av-pay av-pay--footer" aria-label="Payment methods">
        <span class="av-pay__card av-pay__visa">VISA</span>
        <span class="av-pay__card av-pay__mc"><i></i><i></i></span>
        <span class="av-pay__card av-pay__apple"> Pay</span>
        <span class="av-pay__card av-pay__gpay">G Pay</span>
        <span class="av-pay__card av-pay__pp">PayPal</span>
        <span class="av-pay__card av-pay__amex">AMEX</span>
        <span class="av-pay__card av-pay__banc">Bancontact</span>
      </div>
      <p class="av-copy">© 2026 WalkWise</p>
    </div>
  </footer>

  {%- comment -%} ========== Sticky add-to-cart bar ========== {%- endcomment -%}
  <div class="av-sticky" data-av-sticky hidden>
    <form class="av-form av-sticky__form"
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          data-av-cart-form>
      {%- if has_product -%}
        <input type="hidden" name="id" value="{% if section.settings.variant_double != blank %}{{ section.settings.variant_double }}{% else %}{{ current_variant.id }}{% endif %}" data-av-variant>
      {%- endif -%}
      <input type="hidden" name="quantity" value="{% if section.settings.variant_double != blank %}1{% else %}2{% endif %}" data-av-qty>
      <button type="submit" class="av-cta av-cta--sticky" data-av-cta>
        <span class="av-cta__ico" aria-hidden="true">🛒</span>
        <span>Add to cart</span>
        <span class="av-cta__sep">|</span>
        <span class="av-cta__price" data-av-cta-price>$89.00</span>
        <span class="av-cta__was" data-av-cta-was>$196.00</span>
      </button>
    </form>
  </div>

  {%- comment -%} ========== Cart drawer (slide-in) ========== {%- endcomment -%}
  <div class="av-drawer" data-av-drawer aria-hidden="true">
    <div class="av-drawer__overlay" data-av-drawer-close tabindex="-1"></div>
    <aside class="av-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
      <header class="av-drawer__head">
        <h2 class="av-drawer__title"><span class="av-drawer__ico" aria-hidden="true">🛒</span> Your cart <span class="av-drawer__count" data-av-drawer-count></span></h2>
        <button type="button" class="av-drawer__close" data-av-drawer-close aria-label="Close cart">
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </header>

      <div class="av-drawer__body" data-av-drawer-body>
        <div class="av-drawer__loading" data-av-drawer-loading>Loading…</div>
      </div>

      <footer class="av-drawer__foot" data-av-drawer-foot hidden>
        <div class="av-drawer__subtotal">
          <span>Subtotal</span>
          <span data-av-drawer-subtotal>$0.00</span>
        </div>
        <p class="av-drawer__note">🔒 Taxes and shipping calculated at checkout</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="av-cta av-drawer__checkout">
            <span>Checkout</span>
          </button>
        </form>
        <button type="button" class="av-drawer__continue" data-av-drawer-close>Continue shopping</button>
        <div class="av-drawer__pay" aria-label="Payment methods">
          <span class="av-pay__card av-pay__visa">VISA</span>
          <span class="av-pay__card av-pay__mc"><i></i><i></i></span>
          <span class="av-pay__card av-pay__apple"> Pay</span>
          <span class="av-pay__card av-pay__gpay">G Pay</span>
          <span class="av-pay__card av-pay__pp">PayPal</span>
          <span class="av-pay__card av-pay__amex">AMEX</span>
        </div>
      </footer>
    </aside>
  </div>
</div>

{% stylesheet %}
  .av {
    --av-green: #00a308;
    --av-green-dark: #008a07;
    --av-fg: #252525;
    --av-muted: #6b6b6b;
    --av-bg: #ffffff;
    --av-soft: #f6f7f7;
    --av-border: #e4e7e4;
    --av-star: #f5b301;
    --av-black: #111111;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: var(--av-fg);
    background: var(--av-bg);
    font-size: 16px;
    line-height: 1.6;
  }
  .av *, .av *::before, .av *::after { box-sizing: border-box; }
  .av img { max-width: 100%; }
  .av a { color: inherit; text-decoration: none; }

  /* Stars */
  .av-stars { position: relative; display: inline-block; font-size: 1.15rem; letter-spacing: 2px; color: #dcdcdc; line-height: 1; white-space: nowrap; }
  .av-stars::before { content: "★★★★★"; position: absolute; left: 0; top: 0; width: var(--pct, 92%); overflow: hidden; color: var(--av-star); white-space: nowrap; }

  /* Announcement */
  .av-ann { display: flex; align-items: center; justify-content: center; gap: 1rem; background: #000; color: #fff; padding: .7rem 1rem; font-size: .95rem; }
  .av-ann__arrow { background: none; border: none; color: #fff; cursor: pointer; padding: 0 .25rem; display: inline-flex; }
  .av-ann__viewport { position: relative; min-height: 1.4em; display: flex; align-items: center; justify-content: center; min-width: min(80vw, 360px); text-align: center; }
  .av-ann__slide { position: absolute; opacity: 0; transition: opacity .4s ease; font-weight: 500; pointer-events: none; white-space: nowrap; }
  .av-ann__slide.is-active { position: relative; opacity: 1; pointer-events: auto; }

  /* Header */
  html { scroll-behavior: smooth; }
  #features, #mobility, #reviews, #faq { scroll-margin-top: 96px; }
  .av-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid #f0f0f0; }
  .av-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; max-width: 1280px; margin: 0 auto; padding: 1rem 1.5rem; }
  .av-nav { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; font-size: 1rem; max-width: 34rem; }
  .av-nav a { color: #1a1a1a; }
  .av-nav a:hover { color: var(--av-green); }
  .av-logo { justify-self: center; display: inline-flex; align-items: center; font-weight: 700; }
  .av-logo__img { display: block; height: 48px; width: auto; }
  .av-logo__text { font-size: 1.35rem; font-weight: 700; color: #1f5c33; letter-spacing: .2px; }
  .av-logo__text--sm { font-size: 1.05rem; }
  .av-logo__accent { color: var(--av-green); }
  .av-logo__tm { font-size: .65rem; margin-top: .15rem; color: #1f5c33; }
  .av-header__actions { justify-self: end; display: flex; align-items: center; gap: 1rem; }
  .av-locale { display: inline-flex; align-items: center; gap: .3rem; background: none; border: none; cursor: pointer; font: inherit; color: #1a1a1a; }
  .av-iconbtn { position: relative; background: none; border: none; cursor: pointer; color: #1a1a1a; display: inline-flex; padding: 0; }
  .av-cart-count { position: absolute; top: -6px; right: -8px; background: var(--av-green); color: #fff; font-size: .68rem; font-weight: 700; min-width: 17px; height: 17px; border-radius: 50%; display: flex; align-items: center; justify-content: center; padding: 0 3px; }

  /* Product */
  .av-product { background: #fff; }
  .av-product__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; max-width: 1280px; margin: 0 auto; padding: 1.5rem 1.5rem 2.5rem; align-items: start; }
  .av-gallery { display: block; }
  .av-gallery__img { width: 100%; height: auto; display: block; border-radius: 12px; background: var(--av-soft); }
  .av-gallery__hero { margin-bottom: .9rem; }
  .av-gallery__rest { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; }

  .av-buybox { position: sticky; top: 90px; }
  .av-rating { display: flex; align-items: center; gap: .6rem; margin-bottom: .9rem; }
  .av-rating__text { font-weight: 600; }
  .av-rating__count { color: var(--av-muted); font-weight: 500; }
  .av-title { font-size: 34px; font-weight: 700; line-height: 1.2; margin: 0 0 1.1rem; color: rgba(0,0,0,.82); }

  .av-price { display: flex; align-items: center; flex-wrap: wrap; gap: .7rem; margin-bottom: 1.1rem; }
  .av-price__now { font-size: 1.75rem; font-weight: 700; }
  .av-price__was { font-size: 1.35rem; color: var(--av-muted); text-decoration: line-through; }
  .av-price__badge { background: var(--av-green); color: #fff; font-weight: 700; font-size: .82rem; padding: .4rem .7rem; border-radius: 8px; letter-spacing: .3px; }

  .av-pro-badge { display: inline-flex; align-items: center; gap: .7rem; background: #eef6f6; border: 1px solid #cde3e2; border-radius: 999px; padding: .4rem 1.1rem .4rem .4rem; margin-bottom: 1.4rem; }
  .av-pro-badge__ico { flex: none; width: 34px; height: 34px; border-radius: 50%; background: #0f6e6b; display: inline-flex; align-items: center; justify-content: center; }
  .av-pro-badge__text { font-size: .84rem; font-weight: 600; letter-spacing: .2px; color: #1c3d3c; }
  .av-pro-badge__text strong { text-transform: uppercase; font-weight: 800; letter-spacing: .3px; color: #0f6e6b; margin-right: .2rem; }

  .av-checks { list-style: none; padding: 0; margin: 0 0 1.75rem; }
  .av-checks li { display: flex; align-items: center; gap: .6rem; margin-bottom: .85rem; font-size: 1.05rem; font-weight: 600; }
  .av-checks__ico { flex: none; color: var(--av-green); }

  .av-offer-title { display: flex; align-items: center; text-align: center; gap: 1rem; margin: 0 0 1rem; font-weight: 600; }
  .av-offer-title::before, .av-offer-title::after { content: ""; flex: 1; height: 1px; background: var(--av-border); }
  .av-offers { display: flex; flex-direction: column; gap: .9rem; margin-bottom: 1.4rem; }
  .av-offer { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; border: 2px solid var(--av-border); border-radius: 12px; padding: 1.1rem 1.1rem; cursor: pointer; transition: border-color .15s ease, background .15s ease; }
  .av-offer.is-selected { border-color: #111; }
  .av-offer input { position: absolute; opacity: 0; pointer-events: none; }
  .av-offer__flag { position: absolute; top: -.8rem; right: 1rem; background: #000; color: #fff; font-size: .72rem; font-weight: 600; padding: .28rem .65rem; border-radius: 6px; }
  .av-offer__flag--best { background: var(--av-green); }
  .av-offer__thumb { width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: var(--av-soft); flex: none; }
  .av-offer__thumb img { width: 100%; height: 100%; object-fit: contain; }
  .av-offer__name { font-weight: 700; font-size: 1.15rem; }
  .av-offer__tag { display: inline-block; background: #ececec; color: var(--av-fg); font-size: .72rem; font-weight: 600; padding: .2rem .5rem; border-radius: 5px; margin-left: .3rem; vertical-align: middle; }
  .av-offer__sub { display: block; font-size: .9rem; color: var(--av-muted); margin-top: .15rem; }
  .av-offer__price { text-align: right; white-space: nowrap; }
  .av-offer__now { display: block; font-weight: 700; font-size: 1.35rem; }
  .av-offer__was { display: block; font-size: .9rem; color: var(--av-muted); text-decoration: line-through; }

  .av-trust { margin-top: 1rem; text-align: center; }
  .av-trust__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem 1.4rem; font-weight: 600; font-size: .88rem; margin: 0 0 .55rem; }
  .av-trust__item { display: inline-flex; align-items: center; gap: .35rem; white-space: nowrap; }
  .av-trust__item svg { color: var(--av-green); flex: none; }
  .av-trust__delivery { font-size: .92rem; color: #444; margin: 0; }
  .av-trust__delivery strong { color: var(--av-fg); }

  /* CTA */
  .av-form { margin: 0; }
  .av-cta { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .5rem; width: 100%; background: var(--av-green); color: #fff; font-size: 1.2rem; font-weight: 600; padding: 1.05rem 1.25rem; border: none; border-radius: 10px; cursor: pointer; min-height: 60px; transition: background .15s ease, transform .05s ease; font-family: inherit; }
  .av-cta:hover { background: var(--av-green-dark); }
  .av-cta:active { transform: translateY(1px); }
  .av-cta:focus-visible { outline: 4px solid #f5b301; outline-offset: 3px; }
  .av-cta[disabled], .av-cta.is-loading { background: #9aa5a2; cursor: not-allowed; }
  .av-cta__sep { opacity: .55; }
  .av-cta__was { text-decoration: line-through; opacity: .8; font-weight: 500; }

  .av-cart-msg { margin: .75rem 0 0; text-align: center; font-weight: 600; font-size: .95rem; }
  .av-cart-msg[hidden] { display: none; }
  .av-cart-msg.is-success { color: var(--av-green-dark); }
  .av-cart-msg.is-error { color: #c0392b; }


  /* Payment badges */
  .av-pay { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem; margin-top: 1rem; }
  .av-pay__card { height: 26px; min-width: 40px; padding: 0 6px; border-radius: 4px; background: #fff; border: 1px solid #e2e2e2; font-size: .62rem; font-weight: 800; letter-spacing: .3px; display: inline-flex; align-items: center; justify-content: center; color: #1a1a6b; }
  .av-pay__visa { color: #1a1f71; }
  .av-pay__mc { gap: 0; }
  .av-pay__mc i { width: 15px; height: 15px; border-radius: 50%; display: inline-block; }
  .av-pay__mc i:first-child { background: #eb001b; }
  .av-pay__mc i:last-child { background: #f79e1b; margin-left: -6px; mix-blend-mode: multiply; }
  .av-pay__apple { color: #000; }
  .av-pay__apple::before { content: ""; display: inline-block; }
  .av-pay__gpay { color: #5f6368; }
  .av-pay__pp { color: #003087; }
  .av-pay__amex { color: #fff; background: #2e77bc; border-color: #2e77bc; }
  .av-pay__banc { color: #005498; font-size: .55rem; }

  /* Featured testimonial */
  .av-hero-quote { border: 1px solid var(--av-border); border-radius: 14px; padding: 1.5rem; margin: 1.75rem 0 0; }
  .av-hero-quote blockquote { margin: .6rem 0 1rem; font-size: 1.02rem; }
  .av-hero-quote figcaption { display: flex; flex-direction: column; }
  .av-hero-quote__name { font-weight: 700; }
  .av-hero-quote__meta { color: var(--av-muted); font-size: .85rem; }

  /* Accordions */
  .av-acc-group { margin-top: 1.25rem; }
  .av-acc { border-bottom: 1px solid var(--av-border); }
  .av-acc summary { cursor: pointer; list-style: none; padding: 1.15rem 2rem 1.15rem 0; position: relative; font-size: 1.05rem; font-weight: 600; display: flex; align-items: center; gap: .6rem; }
  .av-acc summary::-webkit-details-marker { display: none; }
  .av-acc summary::after { content: "+"; position: absolute; right: .1rem; top: 50%; transform: translateY(-50%); font-size: 1.6rem; color: #444; font-weight: 400; }
  .av-acc[open] summary::after { content: "–"; }
  .av-acc__ico { color: #444; font-size: 1rem; }
  .av-acc__body { padding: 0 0 1.15rem; color: #444; }
  .av-acc__body p { margin: 0 0 .8rem; }
  .av-acc__body p:last-child { margin-bottom: 0; }

  /* Press marquee */
  .av-press { padding: 2.25rem 0; background: var(--av-soft); }
  .av-marquee { overflow: hidden; width: 100%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .av-marquee__track { display: flex; align-items: center; gap: 3.5rem; width: max-content; animation: av-scroll 22s linear infinite; }
  .av-press__logo { display: inline-flex; align-items: center; justify-content: center; width: 150px; height: 40px; flex: 0 0 auto; }
  .av-press__logo img { display: block; width: 100%; height: 100%; object-fit: contain; opacity: .85; }
  @keyframes av-scroll { from { transform: translateX(0); } to { transform: translateX(-25%); } }
  @media (prefers-reduced-motion: reduce) { .av-marquee__track { animation: none; } }

  /* Reviews */
  .av-reviews { padding: 3rem 1.5rem; max-width: 1200px; margin: 0 auto; }
  .av-reviews__head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.75rem; }
  .av-reviews__title { font-size: clamp(1.5rem, 2.6vw, 2rem); font-weight: 700; margin: 0; }
  .av-reviews__summary { display: flex; align-items: center; gap: .5rem; margin-top: .4rem; }
  .av-reviews__score { font-weight: 700; }
  .av-reviews__count { color: var(--av-muted); }
  .av-review-write-btn { display: inline-flex; align-items: center; gap: .5rem; background: #fff; color: var(--av-green-dark); border: 2px solid var(--av-green); border-radius: 10px; padding: .7rem 1.25rem; font: inherit; font-weight: 600; cursor: pointer; transition: background .15s ease, color .15s ease; }
  .av-review-write-btn:hover { background: var(--av-green); color: #fff; }

  .av-review-form { background: var(--av-soft); border: 1px solid var(--av-border); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.75rem; max-width: 640px; }
  .av-review-form[hidden] { display: none; }
  .av-review-form__title { font-size: 1.2rem; font-weight: 700; margin: 0 0 1rem; }
  .av-review-form__label { display: block; font-weight: 600; margin-bottom: .4rem; }
  .av-rate { display: inline-flex; gap: .2rem; margin-bottom: 1rem; }
  .av-rate__star { background: none; border: none; padding: 0 .1rem; font-size: 1.9rem; line-height: 1; cursor: pointer; color: #dcdcdc; transition: color .1s ease; }
  .av-rate__star.is-on { color: var(--av-star); }
  .av-rate__star:focus-visible { outline: 2px solid var(--av-green); outline-offset: 2px; border-radius: 4px; }
  .av-review-form__row { margin-bottom: .9rem; }
  .av-review-form__input, .av-review-form__textarea { width: 100%; border: 1px solid var(--av-border); border-radius: 10px; padding: .8rem 1rem; font: inherit; background: #fff; color: var(--av-fg); }
  .av-review-form__input:focus, .av-review-form__textarea:focus { outline: none; border-color: var(--av-green); }
  .av-review-form__textarea { resize: vertical; min-height: 96px; }
  .av-review-form__submit { background: var(--av-green); color: #fff; border: none; border-radius: 10px; padding: .85rem 1.5rem; font: inherit; font-weight: 600; cursor: pointer; transition: background .15s ease; }
  .av-review-form__submit:hover { background: var(--av-green-dark); }
  .av-review-form__msg { margin: .85rem 0 0; font-weight: 600; font-size: .95rem; }
  .av-review-form__msg[hidden] { display: none; }
  .av-review-form__msg.is-success { color: var(--av-green-dark); }
  .av-review-form__msg.is-error { color: #c0392b; }
  .av-review-form__file-btn { display: inline-flex; align-items: center; gap: .5rem; background: #fff; color: var(--av-fg); border: 1px dashed var(--av-border); border-radius: 10px; padding: .65rem 1.1rem; font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; transition: border-color .15s ease, color .15s ease; }
  .av-review-form__file-btn:hover { border-color: var(--av-green); color: var(--av-green-dark); }
  .av-review-form__preview { position: relative; display: inline-block; margin-top: .8rem; }
  .av-review-form__preview[hidden] { display: none; }
  .av-review-form__preview img { display: block; width: 96px; height: 96px; object-fit: cover; border-radius: 10px; border: 1px solid var(--av-border); }
  .av-review-form__remove { position: absolute; top: -8px; right: -8px; width: 24px; height: 24px; border-radius: 50%; background: #222; color: #fff; border: 2px solid #fff; font-size: .7rem; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; }

  .av-reviews__grid { column-count: 4; column-gap: 1.25rem; }
  .av-review { display: block; width: 100%; break-inside: avoid; -webkit-column-break-inside: avoid; background: #fff; border: 1px solid rgba(0,0,0,.06); border-radius: 16px; padding: 0; margin: 0 0 1.25rem; overflow: hidden; box-shadow: 0 1px 2px rgba(20,20,20,.04), 0 6px 16px rgba(20,20,20,.05); }
  .av-review--extra.is-collapsed { display: none; }
  .av-review--user { border-color: var(--av-green); box-shadow: 0 0 0 1px var(--av-green) inset; }
  .av-review__img { display: block; width: 100%; height: auto; background: var(--av-soft); }
  .av-review__body { padding: 1rem 1.15rem 1.25rem; }
  .av-review__name { font-weight: 700; font-size: 1rem; margin: 0; display: flex; align-items: center; gap: .35rem; flex-wrap: nowrap; min-width: 0; }
  .av-review__name-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .av-review__badge { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 50%; background: var(--av-green); color: #fff; font-size: 0; }
  .av-review__badge::before { content: "✔"; font-size: 9px; line-height: 1; }
  .av-review blockquote { margin: .55rem 0 0; font-size: .95rem; line-height: 1.55; color: #3a3a3a; }
  .av-review__date { display: block; color: var(--av-muted); font-size: .82rem; margin-top: .2rem; }
  .av-review .av-stars { margin-top: .55rem; }
  .av-reviews__more { text-align: center; margin-top: 2rem; }
  .av-reviews__more-btn { background: #fff; color: var(--av-fg); border: 2px solid var(--av-border); border-radius: 10px; padding: .85rem 1.75rem; font: inherit; font-weight: 600; cursor: pointer; transition: border-color .15s ease, color .15s ease; }
  .av-reviews__more-btn:hover { border-color: var(--av-green); color: var(--av-green-dark); }
  .av-reviews__more-btn[hidden] { display: none; }

  /* Feature story */
  .av-story { max-width: 1180px; margin: 0 auto; padding: 1rem 1.5rem 2rem; }
  .av-story__h3 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 700; margin: 1.5rem 0 1rem; line-height: 1.35; }
  .av-story__h5 { font-size: 1.2rem; font-weight: 500; margin: 1.25rem 0; line-height: 1.6; }
  .av-story__p { font-size: 1.15rem; margin: 1.1rem 0; line-height: 1.7; }
  .av-story__p strong { font-weight: 700; }
  .av-story__gif_video { max-width: 800px }
  .av-story__img { text-align: center; margin: 1.25rem 0; }
  .av-story__img img { display: inline-block; border-radius: 8px; }
  .av-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin: 2rem 0; }
  .av-quote { margin: 0; padding: 1.5rem 1.4rem; background: var(--av-soft); border-radius: 14px; display: flex; flex-direction: column; }
  .av-quote__stars { color: #f5a623; font-size: 1rem; letter-spacing: 2px; margin-bottom: .75rem; }
  .av-quote__text { margin: 0 0 1rem; font-size: .98rem; line-height: 1.65; color: #333; font-style: normal; flex: 1; }
  .av-quote__author { font-size: .88rem; font-weight: 700; color: #1a1a1a; }
  .av-quote__author::before { content: "— "; font-weight: 400; color: #888; }
  @media (max-width: 749px) { .av-quotes { grid-template-columns: 1fr; gap: .9rem; } }
  .av-media-duo { display: flex; justify-content: center; align-items: stretch; gap: .9rem; margin: 1.25rem 0; }
  .av-media-duo img, .av-media-duo video { height: 400px; width: auto; max-width: 48%; object-fit: cover; border-radius: 8px; display: block; }
 
  .av-story__imgpair { display: grid; grid-template-columns: 1fr 1fr; gap: .9rem; justify-items: center; align-items: center; margin: 1.25rem 0; }
  .av-story__imgpair img { width: 100%; max-width: 800px; height: auto; border-radius: 8px; }
  @media (max-width: 749px) { .av-story__imgpair { grid-template-columns: 1fr; } }
  .av-featgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.1rem; margin: 2rem 0 2.5rem; }
  .av-featcard { display: flex; flex-direction: column; align-items: flex-start; gap: 0; background: var(--av-soft); border-radius: 16px; padding: 1.6rem 1.5rem; transition: transform .2s ease, box-shadow .2s ease; }
  .av-featcard:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0, 0, 0, .07); }
  .av-featcard__ico { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--av-green); color: #fff; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
  .av-featcard__title { margin: 0 0 .45rem; font-family: inherit; font-size: 1.02rem; font-weight: 700; line-height: 1.3; }
  .av-featcard__text { margin: 0; font-size: .92rem; line-height: 1.6; color: #555; }
  @media (max-width: 989px) { .av-featgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 749px) { .av-featgrid { grid-template-columns: 1fr; gap: .9rem; } .av-featcard { flex-direction: row; gap: 1rem; padding: 1.25rem; } .av-featcard__ico { width: 40px; height: 40px; margin-bottom: 0; } }
  @media (min-width: 750px) {
    .av-story__img img { max-width: 800px; }
  }

  /* Stats */
  .av-stats { padding: 2rem 1.5rem 3rem; background: var(--av-soft); }
  .av-stats__title { text-align: center; font-size: 1.2rem; margin: 0 0 2rem; }
  .av-stats__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; max-width: 900px; margin: 0 auto; }
  .av-stat { text-align: center; }
  .av-stat__num { display: block; font-size: 3.2rem; font-weight: 800; line-height: 1; margin-bottom: .6rem; }
  .av-stat__label { font-size: 1rem; color: #333; }

  /* Comparison */
  .av-compare { padding: 3rem 1.5rem; }
  .av-compare__h2 { text-align: center; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 700; margin: 0 0 1.5rem; }
  .av-compare__sub { text-align: center; font-size: 1.15rem; margin: 0 0 1.5rem; }
  .av-table-wrap { overflow-x: auto; max-width: 820px; margin: 0 auto; }
  .av-table { width: 100%; border-collapse: collapse; font-size: 1.05rem; min-width: 480px; }
  .av-table th, .av-table td { padding: 1rem; border-bottom: 1px solid var(--av-border); text-align: center; vertical-align: middle; }
  .av-table thead th { font-weight: 700; padding-bottom: 1.25rem; }
  .av-table tbody th { text-align: left; font-weight: 600; }
  .av-table .av-col-us { background: #f4f4f4; }
  .av-table tbody tr:last-child th, .av-table tbody tr:last-child td { border-bottom: none; }
  .av-yes::before { content: "✓"; color: #111; font-size: 1.3rem; font-weight: 700; }
  .av-no::before { content: "✕"; color: #111; font-size: 1.2rem; }

  /* Video */
  .av-video { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 3rem; text-align: center; }
  .av-video__title { font-size: clamp(1.5rem, 2.8vw, 2rem); font-weight: 700; margin: 0 0 1.5rem; }
  .av-video__frame { position: relative; border-radius: 14px; overflow: hidden; background: #000; }
  .av-video__el { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .av-video__play { position: absolute; inset: 0; margin: auto; width: 74px; height: 74px; border-radius: 50%; border: 2px solid rgba(255,255,255,.9); background: rgba(0,0,0,.25); color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center; padding-left: 4px; }
  .av-video__frame.is-playing .av-video__play { display: none; }

  /* Help / FAQ */
  .av-help { max-width: 820px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }
  .av-help__title { text-align: center; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; margin: 0 0 1rem; }
  .av-help__lead { text-align: center; color: #333; margin: 0 auto 2rem; max-width: 620px; }
  .av-help__faqtitle { font-size: 1.4rem; font-weight: 700; margin: 0 0 .5rem; }
  .av-faq .av-acc summary { font-weight: 600; }

  /* Footer utilities */
  .av-futil { background: #000; padding: 3.5rem 1.5rem 0; }
  .av-futil__card { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; padding: 0 1rem; }
  .av-futil__item { text-align: center; color: #fff; }
  .av-futil__item:not(:first-child) { border-left: 1px solid #232323; }
  .av-futil__ico { width: 52px; height: 52px; border-radius: 50%; background: rgba(0, 163, 8, .12); color: var(--av-green); display: inline-flex; align-items: center; justify-content: center; margin-bottom: .9rem; }
  .av-futil__item h3 { font-family: inherit; font-size: 1rem; font-weight: 600; margin: 0 0 .45rem; letter-spacing: .2px; }
  .av-futil__item p { font-size: .88rem; line-height: 1.6; color: #9a9a9a; margin: 0; max-width: 24ch; margin-inline: auto; }
  .av-futil__item a { color: #cfcfcf; text-decoration: underline; text-underline-offset: 3px; }
  .av-futil__item a:hover { color: #fff; }

  /* Footer */
  .av-footer { background: #000; color: #fff; padding: 3.5rem 1.5rem 1.5rem; }
  .av-footer__inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .av-footer__col h4 { font-size: 1.3rem; font-weight: 700; margin: 0 0 1.25rem; }
  .av-footer__col ul { list-style: none; padding: 0; margin: 0; }
  .av-footer__col li { margin-bottom: .9rem; }
  .av-footer__col a { color: #eaeaea; }
  .av-footer__col a:hover { color: #fff; text-decoration: underline; }
  .av-footer__news p { color: #cfcfcf; margin: 0 0 1.25rem; }
  .av-news { display: flex; align-items: center; gap: .5rem; max-width: 320px; border: 1px solid #fff; border-radius: 10px; padding: .3rem .3rem .3rem 1rem; }
  .av-news input { flex: 1 1 auto; min-width: 0; background: none; border: none; color: #fff; font: inherit; padding: .7rem 0; outline: none; -webkit-appearance: none; appearance: none; border-radius: 0; }
  .av-news input::placeholder { color: #cfcfcf; }
  .av-news button { flex: none; width: 40px; height: 40px; box-sizing: border-box; background: var(--av-green); border: none; color: #fff; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; line-height: 0; border-radius: 7px; transition: background .15s ease; -webkit-appearance: none; appearance: none; }
  .av-news button svg { display: block; }
  .av-news button:hover { background: var(--av-green-dark, #008a07); }
  .av-news:focus-within { border-color: var(--av-green); }
  .av-news__msg { font-size: .9rem; margin: 0 0 .75rem; padding: .65rem .9rem; border-radius: 8px; max-width: 320px; }
  .av-news__msg--ok { background: rgba(0, 163, 8, .15); color: #7ed687; }
  .av-news__msg--err { background: rgba(220, 60, 60, .15); color: #f2a1a1; }
  .av-toast { position: fixed; bottom: 24px; left: 50%; transform: translate(-50%, 12px); z-index: 300; display: flex; align-items: center; gap: .75rem; background: #1c1c1c; color: #fff; font-size: .92rem; padding: .8rem 1rem .8rem 1.15rem; border-radius: 10px; box-shadow: 0 8px 24px rgba(0, 0, 0, .35); opacity: 0; transition: opacity .25s ease, transform .25s ease; max-width: calc(100vw - 2rem); }
  .av-toast.is-visible { opacity: 1; transform: translate(-50%, 0); }
  .av-toast--err { background: #7a2222; }
  .av-toast__close { background: none; border: none; color: #bbb; cursor: pointer; font-size: .85rem; padding: .2rem; line-height: 1; }
  .av-toast__close:hover { color: #fff; }
  .av-footer__bottom { max-width: 1200px; margin: 3rem auto 0; padding-top: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
  .av-copy { margin: 0; color: #cfcfcf; }

  /* Sticky bar */
  .av-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; background: transparent; padding: .6rem 1rem; }
  .av-sticky[hidden] { display: none; }
  .av-sticky__form { max-width: 1100px; margin: 0 auto; }
  .av-cta--sticky { min-height: 52px; font-size: 1.1rem; box-shadow: 0 8px 24px rgba(0,0,0,.18); }

  /* Cart drawer */
  .av-drawer { position: fixed; inset: 0; z-index: 200; visibility: hidden; pointer-events: none; }
  .av-drawer.is-open { visibility: visible; pointer-events: auto; }
  .av-drawer__overlay { position: absolute; inset: 0; background: rgba(0,0,0,.45); opacity: 0; transition: opacity .35s ease; }
  .av-drawer.is-open .av-drawer__overlay { opacity: 1; }
  .av-drawer__panel { position: absolute; top: 0; right: 0; height: 100%; width: min(420px, 100%); background: var(--av-bg); display: flex; flex-direction: column; box-shadow: -12px 0 40px rgba(0,0,0,.18); transform: translateX(100%); transition: transform .38s cubic-bezier(.22,.61,.36,1); will-change: transform; }
  .av-drawer.is-open .av-drawer__panel { transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) { .av-drawer__panel, .av-drawer__overlay { transition: none; } }

  .av-drawer__head { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.4rem; border-bottom: 1px solid var(--av-border); }
  .av-drawer__title { font-size: 1.2rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: .5rem; }
  .av-drawer__count { color: var(--av-muted); font-weight: 600; font-size: 1rem; }
  .av-drawer__close { background: none; border: none; cursor: pointer; color: var(--av-fg); display: inline-flex; padding: .25rem; border-radius: 8px; }
  .av-drawer__close:hover { background: var(--av-soft); }

  .av-drawer__body { flex: 1 1 auto; overflow-y: auto; padding: .5rem 1.4rem; }
  .av-drawer__loading { text-align: center; color: var(--av-muted); padding: 3rem 1rem; }
  .av-drawer__empty { text-align: center; color: var(--av-muted); padding: 3.5rem 1rem; }
  .av-drawer__empty-ico { font-size: 2.75rem; margin-bottom: .5rem; }

  .av-ci { display: grid; grid-template-columns: 72px 1fr auto; gap: .9rem; align-items: start; padding: 1.1rem 0; border-bottom: 1px solid var(--av-border); }
  .av-ci__img { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; background: var(--av-soft); }
  .av-ci__img--ph { display: block; }
  .av-ci__title { font-weight: 600; margin: 0; font-size: .98rem; line-height: 1.3; }
  .av-ci__variant { color: var(--av-muted); font-size: .85rem; margin: .2rem 0 0; }
  .av-ci__qty { display: inline-flex; align-items: center; gap: 0; margin-top: .6rem; border: 1px solid var(--av-border); border-radius: 8px; overflow: hidden; }
  .av-ci__qbtn { width: 30px; height: 30px; background: #fff; border: none; cursor: pointer; font-size: 1.1rem; line-height: 1; color: var(--av-fg); }
  .av-ci__qbtn:hover { background: var(--av-soft); }
  .av-ci__qbtn:disabled { opacity: .5; cursor: default; }
  .av-ci__qval { min-width: 34px; text-align: center; font-weight: 600; font-size: .95rem; }
  .av-ci__right { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
  .av-ci__price { font-weight: 700; margin: 0; white-space: nowrap; }
  .av-ci__remove { background: none; border: none; color: var(--av-muted); cursor: pointer; font-size: .82rem; text-decoration: underline; padding: 0; }
  .av-ci__remove:hover { color: #c0392b; }

  .av-drawer__foot { border-top: 1px solid var(--av-border); padding: 1.25rem 1.4rem calc(1.25rem + env(safe-area-inset-bottom)); }
  .av-drawer__foot[hidden] { display: none; }
  .av-drawer__subtotal { display: flex; align-items: center; justify-content: space-between; font-size: 1.15rem; font-weight: 700; margin-bottom: .35rem; }
  .av-drawer__note { color: var(--av-muted); font-size: .85rem; text-align: center; margin: 0 0 1rem; }
  .av-drawer__checkout { min-height: 56px; font-size: 1.15rem; }
  .av-drawer__continue { display: block; width: 100%; background: none; border: none; color: var(--av-fg); text-decoration: underline; cursor: pointer; font: inherit; font-weight: 600; margin-top: .9rem; }
  .av-drawer__continue:hover { color: var(--av-green-dark); }
  .av-drawer__pay { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .4rem; margin-top: 1rem; }

  /* Responsive */
  @media (max-width: 900px) {
    .av-futil__card { grid-template-columns: repeat(2, 1fr); }
    .av-futil__item:not(:first-child) { border-left: none; }
    .av-reviews__grid { column-count: 2; }
  }
  @media (max-width: 749px) {
    .av-header__inner { grid-template-columns: auto 1fr auto; gap: .5rem; padding: .75rem 1rem; }
    .av-nav { display: none; }
    .av-product__inner { grid-template-columns: 1fr; gap: 1.5rem; padding: 1rem 1rem 2rem; }
    .av-buybox { position: static; top: auto; }
    /* Gallery: hero image, then remaining images as a swipeable carousel */
    .av-gallery__rest {
      grid-template-columns: none;
      display: flex;
      gap: .6rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: .5rem;
      scrollbar-width: none;
      scroll-padding: 0 1rem;
    }
    .av-gallery__rest::-webkit-scrollbar { display: none; }
    .av-gallery__rest .av-gallery__img { flex: 0 0 25%; width: 25%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 10px; scroll-snap-align: start; }
    .av-title { font-size: 1.6rem; }
    .av-reviews__grid { column-count: 3; column-gap: .6rem; }
    .av-review { border-radius: 14px; margin-bottom: .6rem; }
    .av-review__body { padding: .7rem .65rem .85rem; }
    .av-review__name { font-size: .8rem; gap: .25rem; }
    .av-review__badge { width: 12px; height: 12px; }
    .av-review__badge::before { font-size: 7px; }
    .av-review__date { font-size: .7rem; margin-top: .15rem; }
    .av-review blockquote { font-size: .78rem; line-height: 1.45; margin-top: .5rem; }
    .av-review .av-stars { font-size: .78rem; margin-top: .5rem; }
    .av-stats__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .av-futil__card { grid-template-columns: 1fr; }
    .av-footer { padding-bottom: 120px; }
    .av-footer__inner { grid-template-columns: 1fr; gap: 2rem; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    document.querySelectorAll('[data-av-root]').forEach(function (root) {
      /* Rotating announcement */
      (function () {
        var wrap = root.querySelector('[data-av-ann]');
        if (!wrap) return;
        var slides = Array.prototype.slice.call(wrap.querySelectorAll('[data-av-ann-slide]'));
        if (slides.length < 2) return;
        var idx = 0, timer;
        function show(i) { idx = (i + slides.length) % slides.length; slides.forEach(function (s, n) { s.classList.toggle('is-active', n === idx); }); }
        function next() { show(idx + 1); }
        function prev() { show(idx - 1); }
        function start() { stop(); timer = setInterval(next, 4000); }
        function stop() { if (timer) clearInterval(timer); }
        var n = wrap.querySelector('[data-av-ann-next]'), p = wrap.querySelector('[data-av-ann-prev]');
        if (n) n.addEventListener('click', function () { next(); start(); });
        if (p) p.addEventListener('click', function () { prev(); start(); });
        start();
      })();

      /* Mobile gallery: tap a thumbnail to swap it into the hero banner */
      (function () {
        var hero = root.querySelector('[data-av-gallery-hero]');
        var rest = root.querySelector('[data-av-gallery-rest]');
        if (!hero || !rest) return;
        var mq = window.matchMedia('(max-width: 749px)');
        function swap(thumb) {
          if (!mq.matches) return;
          var heroSrc = hero.src;
          hero.src = thumb.src;
          thumb.src = heroSrc;
        }
        rest.querySelectorAll('[data-av-gallery-thumb]').forEach(function (thumb) {
          thumb.addEventListener('click', function () { swap(thumb); });
          thumb.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); swap(thumb); }
          });
        });
      })();

      /* Offer selector */
      (function () {
        var group = root.querySelector('[data-av-offers]');
        if (!group) return;
        var offers = group.querySelectorAll('.av-offer');
        offers.forEach(function (offer) {
          offer.addEventListener('click', function () {
            offers.forEach(function (o) { o.classList.remove('is-selected'); });
            offer.classList.add('is-selected');
            var radio = offer.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;
            var price = offer.getAttribute('data-price'), was = offer.getAttribute('data-was'), qty = offer.getAttribute('data-qty'), variant = offer.getAttribute('data-variant');
            root.querySelectorAll('[data-av-cta-price]').forEach(function (el) { if (price) el.textContent = price; });
            root.querySelectorAll('[data-av-cta-was]').forEach(function (el) { if (was) el.textContent = was; });
            root.querySelectorAll('[data-av-qty]').forEach(function (q) { if (qty) q.value = qty; });
            if (variant) { root.querySelectorAll('[data-av-variant]').forEach(function (v) { v.value = variant; }); }
          });
        });
      })();

      /* Video play */
      (function () {
        var frame = root.querySelector('[data-av-video]');
        if (!frame) return;
        var vid = frame.querySelector('video'), btn = frame.querySelector('[data-av-video-play]');
        if (!vid || !btn) return;
        btn.addEventListener('click', function () { frame.classList.add('is-playing'); vid.play(); });
        vid.addEventListener('pause', function () { if (vid.currentTime === 0) frame.classList.remove('is-playing'); });
      })();

      /* Add to cart (AJAX with fallback) */
      (function () {
        var addUrl = root.getAttribute('data-cart-add-url') || '/cart/add';
        var cartUrl = root.getAttribute('data-cart-url') || '/cart';
        root.querySelectorAll('[data-av-cart-form]').forEach(function (form) {
          form.addEventListener('submit', function (e) {
            var variant = form.querySelector('[data-av-variant]');
            if (!variant || !variant.value) {
              e.preventDefault();
              showMsg(form, 'Select a product in the theme editor to enable add to cart.', 'error');
              return;
            }
            e.preventDefault();
            var btn = form.querySelector('[data-av-cta]');
            if (btn) { btn.classList.add('is-loading'); btn.setAttribute('aria-busy', 'true'); }
            fetch(addUrl + '.js', { method: 'POST', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, body: new FormData(form) })
              .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
              .then(function (r) {
                if (btn) { btn.classList.remove('is-loading'); btn.removeAttribute('aria-busy'); }
                if (!r.ok) { showMsg(form, (r.data && r.data.description) || 'Could not add to cart.', 'error'); return; }
                showMsg(form, 'Added to cart ✓', 'success');
                root.dispatchEvent(new CustomEvent('av:cart:open', { bubbles: false }));
                window.setTimeout(function () { var m = form.querySelector('[data-av-cart-msg]'); if (m) { m.hidden = true; } }, 2500);
              })
              .catch(function () { if (btn) { btn.classList.remove('is-loading'); btn.removeAttribute('aria-busy'); } form.submit(); });
          });
        });
        function showMsg(form, text, kind) {
          var el = form.querySelector('[data-av-cart-msg]');
          if (!el) { return; }
          el.textContent = text; el.classList.remove('is-success', 'is-error');
          el.classList.add(kind === 'success' ? 'is-success' : 'is-error'); el.hidden = false;
        }
      })();

      /* Cart drawer (slide-in) */
      (function () {
        var drawer = root.querySelector('[data-av-drawer]');
        if (!drawer) return;
        var cartUrl = root.getAttribute('data-cart-url') || '/cart';
        var changeUrl = root.getAttribute('data-cart-change-url') || (cartUrl + '/change');
        var body = drawer.querySelector('[data-av-drawer-body]');
        var foot = drawer.querySelector('[data-av-drawer-foot]');
        var subtotalEl = drawer.querySelector('[data-av-drawer-subtotal]');
        var countEl = drawer.querySelector('[data-av-drawer-count]');
        var lastFocus = null;

        function money(c) { return '$' + (c / 100).toFixed(2); }
        function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }

        function updateCount(n) {
          if (countEl) countEl.textContent = n ? '(' + n + ')' : '';
          root.querySelectorAll('[data-av-cart-count]').forEach(function (el) { el.textContent = n; });
        }

        function render(cart) {
          updateCount(cart.item_count);
          if (!cart.items || !cart.items.length) {
            body.innerHTML = '<div class="av-drawer__empty"><p class="av-drawer__empty-ico" aria-hidden="true">🛒</p><p>Your cart is empty.</p></div>';
            if (foot) foot.hidden = true;
            return;
          }
          var html = '';
          cart.items.forEach(function (it) {
            var variant = (it.variant_title && it.variant_title !== 'Default Title') ? '<p class="av-ci__variant">' + esc(it.variant_title) + '</p>' : '';
            var img = it.image ? '<img class="av-ci__img" src="' + it.image + '" alt="" width="72" height="72" loading="lazy">' : '<span class="av-ci__img av-ci__img--ph" aria-hidden="true"></span>';
            html +=
              '<div class="av-ci" data-key="' + it.key + '">' +
                img +
                '<div class="av-ci__info">' +
                  '<p class="av-ci__title">' + esc(it.product_title) + '</p>' +
                  variant +
                  '<div class="av-ci__qty">' +
                    '<button type="button" class="av-ci__qbtn" data-av-qminus aria-label="Decrease quantity">−</button>' +
                    '<span class="av-ci__qval">' + it.quantity + '</span>' +
                    '<button type="button" class="av-ci__qbtn" data-av-qplus aria-label="Increase quantity">+</button>' +
                  '</div>' +
                '</div>' +
                '<div class="av-ci__right">' +
                  '<p class="av-ci__price">' + money(it.final_line_price) + '</p>' +
                  '<button type="button" class="av-ci__remove" data-av-remove>Remove</button>' +
                '</div>' +
              '</div>';
          });
          body.innerHTML = html;
          if (subtotalEl) subtotalEl.textContent = money(cart.total_price);
          if (foot) foot.hidden = false;
        }

        function refresh() {
          body.innerHTML = '<div class="av-drawer__loading">Loading…</div>';
          fetch(cartUrl + '.js', { headers: { 'Accept': 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(render)
            .catch(function () { body.innerHTML = '<div class="av-drawer__empty"><p>Could not load your cart.</p></div>'; });
        }

        function change(key, qty, rowBtn) {
          if (rowBtn) rowBtn.disabled = true;
          fetch(changeUrl + '.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: key, quantity: qty })
          })
            .then(function (res) { return res.json(); })
            .then(render)
            .catch(function () { refresh(); });
        }

        function open() {
          lastFocus = document.activeElement;
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          refresh();
          var closeBtn = drawer.querySelector('.av-drawer__close');
          if (closeBtn) closeBtn.focus();
        }
        function close() {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        /* Item interactions (event delegation) */
        body.addEventListener('click', function (e) {
          var row = e.target.closest('.av-ci');
          if (!row) return;
          var key = row.getAttribute('data-key');
          var qtyEl = row.querySelector('.av-ci__qval');
          var qty = qtyEl ? parseInt(qtyEl.textContent, 10) || 0 : 0;
          if (e.target.closest('[data-av-remove]')) { change(key, 0, e.target); }
          else if (e.target.closest('[data-av-qplus]')) { change(key, qty + 1, e.target); }
          else if (e.target.closest('[data-av-qminus]')) { change(key, Math.max(0, qty - 1), e.target); }
        });

        /* Open / close wiring */
        root.addEventListener('av:cart:open', open);
        drawer.querySelectorAll('[data-av-drawer-close]').forEach(function (el) { el.addEventListener('click', close); });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
        });

        /* Header cart icon opens the drawer instead of navigating */
        var cartLink = root.querySelector('.av-cart-link');
        if (cartLink) { cartLink.addEventListener('click', function (e) { e.preventDefault(); open(); }); }

        /* Reflect current count on page load */
        fetch(cartUrl + '.js', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (c) { updateCount(c.item_count); })
          .catch(function () {});
      })();

      /* Reviews: write a review + show more */
      (function () {
        var section = root.querySelector('[data-av-reviews]');
        if (!section) return;
        var grid = section.querySelector('[data-av-reviews-grid]');
        var toggle = section.querySelector('[data-av-write-toggle]');
        var form = section.querySelector('[data-av-review-form]');
        var moreBtn = section.querySelector('[data-av-more]');
        var countEls = section.querySelectorAll('[data-av-review-count]');
        var msgEl = section.querySelector('[data-av-review-msg]');
        var key = 'av_reviews_' + (section.getAttribute('data-av-reviews') || 'default');
        var BATCH = 3;

        /* Toggle the write-a-review form */
        if (toggle && form) {
          toggle.addEventListener('click', function () {
            var isHidden = form.hasAttribute('hidden');
            if (isHidden) {
              form.removeAttribute('hidden');
              toggle.setAttribute('aria-expanded', 'true');
              var first = form.querySelector('input, textarea');
              if (first) first.focus();
            } else {
              form.setAttribute('hidden', '');
              toggle.setAttribute('aria-expanded', 'false');
            }
          });
        }

        /* Star rating input */
        var rating = 0;
        var rateWrap = section.querySelector('[data-av-rate]');
        var stars = rateWrap ? Array.prototype.slice.call(rateWrap.querySelectorAll('.av-rate__star')) : [];
        function paint(n) { stars.forEach(function (s, i) { s.classList.toggle('is-on', i < n); }); }
        if (rateWrap) {
          stars.forEach(function (s) {
            var v = parseInt(s.getAttribute('data-val'), 10);
            s.addEventListener('mouseenter', function () { paint(v); });
            s.addEventListener('click', function () { rating = v; paint(v); });
          });
          rateWrap.addEventListener('mouseleave', function () { paint(rating); });
        }

        function esc(str) { var d = document.createElement('div'); d.textContent = str == null ? '' : str; return d.innerHTML; }
        function todayFr() {
          var d = new Date();
          function p(n) { return (n < 10 ? '0' : '') + n; }
          var mo = ['January','February','March','April','May','June','July','August','September','October','November','December'];
          return mo[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
        }
        function makeCard(r) {
          var pct = Math.max(0, Math.min(100, Math.round((r.rating / 5) * 100)));
          var fig = document.createElement('figure');
          fig.className = 'av-review av-review--user';
          var imgHtml = r.photo ? '<img class="av-review__img" src="' + esc(r.photo) + '" alt="" loading="lazy">' : '';
          fig.innerHTML =
            imgHtml +
            '<div class="av-review__body">' +
            '<figcaption class="av-review__name"><span class="av-review__name-text">' + esc(r.name) + '</span> <span class="av-review__badge">✔ Posted by you</span></figcaption>' +
            '<time class="av-review__date">' + esc(r.date) + '</time>' +
            '<div class="av-stars" aria-hidden="true" style="--pct:' + pct + '%;">★★★★★</div>' +
            '<blockquote>« ' + esc(r.content) + ' »</blockquote>' +
            '</div>';
          return fig;
        }

        /* Photo upload: read + downscale to keep localStorage small */
        var photoDataUrl = '';
        var photoInput = form ? form.querySelector('[data-av-photo-input]') : null;
        var photoPreview = form ? form.querySelector('[data-av-photo-preview]') : null;
        var photoPreviewImg = photoPreview ? photoPreview.querySelector('img') : null;
        var photoRemoveBtn = form ? form.querySelector('[data-av-photo-remove]') : null;
        function resetPhoto() {
          photoDataUrl = '';
          if (photoInput) photoInput.value = '';
          if (photoPreview) photoPreview.hidden = true;
        }
        if (photoInput) {
          photoInput.addEventListener('change', function () {
            var file = photoInput.files && photoInput.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (e) {
              var img = new Image();
              img.onload = function () {
                var maxDim = 800;
                var scale = Math.min(1, maxDim / Math.max(img.width, img.height));
                var w = Math.round(img.width * scale);
                var h = Math.round(img.height * scale);
                var canvas = document.createElement('canvas');
                canvas.width = w;
                canvas.height = h;
                canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                photoDataUrl = canvas.toDataURL('image/jpeg', 0.82);
                if (photoPreviewImg) photoPreviewImg.src = photoDataUrl;
                if (photoPreview) photoPreview.hidden = false;
              };
              img.src = e.target.result;
            };
            reader.readAsDataURL(file);
          });
        }
        if (photoRemoveBtn) {
          photoRemoveBtn.addEventListener('click', resetPhoto);
        }
        function showMsg(text, kind) {
          if (!msgEl) return;
          msgEl.textContent = text;
          msgEl.classList.remove('is-success', 'is-error');
          msgEl.classList.add(kind === 'success' ? 'is-success' : 'is-error');
          msgEl.hidden = false;
        }

        /* Restore previously submitted reviews */
        var saved = [];
        try { saved = JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { saved = []; }
        if (grid && saved.length) {
          saved.forEach(function (r) { grid.insertBefore(makeCard(r), grid.firstChild); });
          countEls.forEach(function (el) {
            var n = parseInt((el.textContent || '').replace(/\D/g, ''), 10) || 0;
            el.textContent = n + saved.length;
          });
        }

        /* Submit a new review */
        if (form && grid) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var name = (form.querySelector('[name="name"]').value || '').trim();
            var content = (form.querySelector('[name="content"]').value || '').trim();
            if (!rating) { showMsg('Please select a rating.', 'error'); return; }
            if (!name || !content) { showMsg('Please enter your name and review.', 'error'); return; }
            var review = { name: name, content: content, rating: rating, date: todayFr(), photo: photoDataUrl };
            grid.insertBefore(makeCard(review), grid.firstChild);
            saved.unshift(review);
            try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
            countEls.forEach(function (el) {
              var n = parseInt((el.textContent || '').replace(/\D/g, ''), 10) || 0;
              el.textContent = n + 1;
            });
            form.reset();
            rating = 0;
            paint(0);
            resetPhoto();
            showMsg('Thank you! Your review has been published.', 'success');
          });
        }

        /* See more reviews */
        if (moreBtn && grid) {
          moreBtn.addEventListener('click', function () {
            var extras = Array.prototype.slice.call(grid.querySelectorAll('.av-review--extra.is-collapsed'));
            extras.slice(0, BATCH).forEach(function (el) { el.classList.remove('is-collapsed'); });
            if (grid.querySelectorAll('.av-review--extra.is-collapsed').length === 0) {
              moreBtn.hidden = true;
            }
          });
          if (grid.querySelectorAll('.av-review--extra.is-collapsed').length === 0) {
            moreBtn.hidden = true;
          }
        }
      })();

      /* Sticky bar */
      (function () {
        var bar = root.querySelector('[data-av-sticky]');
        var anchor = root.querySelector('.av-buybox .av-cta');
        if (!bar || !anchor || !('IntersectionObserver' in window)) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { bar.hidden = en.isIntersecting || en.boundingClientRect.top > 0; });
        }, { rootMargin: '0px 0px -100% 0px' });
        io.observe(anchor);
      })();
    });
  })();
{% endjavascript %}

