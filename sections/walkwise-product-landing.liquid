        </form>

        <div class="av-pay" aria-label="Payment methods">
          <span class="av-pay__card av-pay__visa">VISA</span>
          <span class="av-pay__card av-pay__mc"><i></i><i></i></span>
          <span class="av-pay__card av-pay__apple"> Pay</span>
          <span class="av-pay__card av-pay__gpay">G Pay</span>
          <span class="av-pay__card av-pay__pp">PayPal</span>
          <span class="av-pay__card av-pay__amex">AMEX</span>
          <span class="av-pay__card av-pay__banc">Bancontact</span>
        </div>

