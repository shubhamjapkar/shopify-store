      {%- assign gallery = section.settings.gallery_images | newline_to_br | strip_newlines | split: '<br />' -%}
      <div class="av-gallery">
        <div class="av-gallery__hero">
          {%- assign idx = 0 -%}
          {%- for src in gallery -%}
            {%- assign s = src | strip -%}
            {%- if s != blank -%}
              {%- assign idx = idx | plus: 1 -%}
              {%- if idx == 1 -%}
                <img class="av-gallery__img" data-av-gallery-hero src="{{ s }}" alt="WalkWise support cane" loading="eager" width="1000" height="1000">
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if idx > 1 -%}
          <div class="av-gallery__rest" data-av-gallery-rest>
            {%- assign idx = 0 -%}
            {%- for src in gallery -%}
              {%- assign s = src | strip -%}
              {%- if s != blank -%}
                {%- assign idx = idx | plus: 1 -%}
                {%- if idx > 1 -%}
                  <img class="av-gallery__img" data-av-gallery-thumb role="button" tabindex="0" src="{{ s }}" alt="WalkWise support cane" loading="lazy" width="1000" height="1000">
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ----- Buy box (sticky) ----- {%- endcomment -%}
