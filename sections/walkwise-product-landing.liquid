{%- comment -%}
  WalkWise — Faithful (pixel-perfect) replica of the walkwise.com product page.
  Self-contained section: announcement bar, header, full product page,
  sales sections, and footer. The theme's header-group / footer-group
  groups are emptied to avoid duplicates.

  Add to cart: native product form + AJAX Cart API (routes.cart_add_url).
  Select a product in the theme editor to enable add to cart.
{%- endcomment -%}

{%- liquid
  # Use the product chosen in the theme editor. If none is set, fall back to the
  # first available store product (then the first product overall) so that
  # "Add to cart" works out of the box without any manual configuration.
  assign product = section.settings.product
  if product == blank or product == empty
    for p in collections.all.products
      if p.available
        assign product = p
        break
      endif
    endfor
  endif
  if product == blank or product == empty
    assign product = collections.all.products.first
  endif

  assign has_product = false
  if product != blank and product != empty
    assign has_product = true
    assign current_variant = product.selected_or_first_available_variant
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&display=swap">

<div class="av av--{{ section.id }}" id="top"
     data-av-root
     data-cart-add-url="{{ routes.cart_add_url }}"
     data-cart-url="{{ routes.cart_url }}"
     data-cart-change-url="{{ routes.cart_change_url }}">

  {%- comment -%} ========== Announcement bar ========== {%- endcomment -%}
  <div class="av-ann" data-av-ann>
    <button class="av-ann__arrow" data-av-ann-prev aria-label="Previous" type="button">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <div class="av-ann__viewport">
      <span class="av-ann__slide is-active" data-av-ann-slide>Special offers today only</span>
      <span class="av-ann__slide" data-av-ann-slide>Free shipping on orders over $59</span>
      <span class="av-ann__slide" data-av-ann-slide>60-Day Money-Back Guarantee</span>
      <span class="av-ann__slide" data-av-ann-slide>15,000+ happy customers</span>
    </div>
    <button class="av-ann__arrow" data-av-ann-next aria-label="Next" type="button">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  {%- comment -%} ========== Header ========== {%- endcomment -%}
